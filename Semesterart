<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Name Every Artwork</title>
<style>
:root{ --navy:#1E2761; --navy2:#141B47; --teal:#1C7293; --gold:#F0B429; --cream:#FBF8F2; --ink:#22283B; --line:#DAD3C3; --green:#2F8F5B; --red:#C0392B; }
*{box-sizing:border-box;}
body{margin:0;background:var(--cream);color:var(--ink);font-family:Georgia,serif;line-height:1.6;}
header{background:linear-gradient(135deg,var(--navy) 0%,var(--navy2) 100%);color:#fff;padding:1.6rem 1.5rem 1.2rem;}
header h1{margin:0 0 .15rem;font-size:1.4rem;}
header p{margin:0;color:#C9D4EA;font-family:Arial,sans-serif;font-size:.85rem;}
main{max-width:800px;margin:0 auto;padding:1.5rem;}
.timerbar{background:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.1);padding:1rem;text-align:center;font-family:Arial,sans-serif;margin-bottom:1.2rem;}
.timer{font-size:2rem;font-weight:900;color:var(--navy);margin:.2rem 0;}
button.big{background:var(--teal);color:#fff;border:none;border-radius:8px;padding:.7rem 1.3rem;font-weight:700;font-size:.9rem;cursor:pointer;font-family:Arial,sans-serif;}
button.big:disabled{background:#ccc;cursor:not-allowed;}
button.ghost{background:none;border:2px solid var(--navy);color:var(--navy);border-radius:8px;padding:.65rem 1.25rem;font-weight:700;cursor:pointer;font-family:Arial,sans-serif;}
button.ghost:disabled{border-color:#ccc;color:#ccc;cursor:not-allowed;}
.card{background:#fff;border-radius:10px;padding:1.4rem 1.6rem;box-shadow:0 2px 10px rgba(0,0,0,.08);margin-bottom:1.2rem;font-family:Arial,sans-serif;}
.card h2{margin-top:0;color:var(--navy);font-size:1.1rem;}
.sub{font-size:.85rem;color:#888;margin-bottom:1rem;}
textarea{width:100%;min-height:180px;padding:.8rem;border:1px solid var(--line);border-radius:8px;font-family:Arial,sans-serif;font-size:.95rem;}
.counter{font-family:Arial,sans-serif;font-weight:700;padding:.5rem;border-radius:6px;background:#F6DADA;color:#C0392B;text-align:center;margin-top:.6rem;}
.counter.done{background:#DCEEDC;color:#2F8F5B;}
.yesno{padding:.5rem .7rem;border-radius:6px;margin-bottom:.4rem;font-size:.88rem;}
.yesno.yes{background:#EAF6EC;border-left:4px solid var(--green);}
.yesno.no{background:#FBEAEA;border-left:4px solid var(--red);}
.hintbox{background:#F0EAD6;border-radius:8px;padding:.9rem 1.1rem;margin-top:.8rem;font-size:.92rem;font-style:italic;}
.stagegap{margin-top:1rem;}
.score{text-align:center;font-size:1.2rem;font-weight:900;color:var(--navy);margin:.5rem 0 1rem;}
.resultgrid{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;}
.hitlist,.misslist{padding:.8rem;border-radius:8px;}
.hitlist{background:#EAF6EC;} .misslist{background:#FBEAEA;}
.hitlist h3{color:var(--green);margin:0 0 .4rem;font-size:.9rem;}
.misslist h3{color:var(--red);margin:0 0 .4rem;font-size:.9rem;}
.item{font-size:.83rem;padding:.15rem 0;}
</style>
</head>
<body>
<header>
  <h1>Name Every Artwork</h1>
  <p>Search Canvas, list everything we studied, check yourself</p>
</header>
<main>
  <div class="timerbar">
    <div style="font-weight:700;color:#666;">Search timer</div>
    <div class="timer" id="timerDisplay">10:00</div>
    <button class="big" id="timerBtn" onclick="startTimer()">Start 10 minute timer</button>
  </div>

  <div class="card">
    <h2>Your List</h2>
    <div class="sub">One artwork, film, or song per line. Titles are enough. You need at least 10 before you can check.</div>
    <textarea id="userList" oninput="updateCounter()" placeholder="Starry Night&#10;Piss Christ&#10;Battle Royale&#10;..."></textarea>
    <div class="counter" id="counter">0 of 10 minimum</div>
    <p class="stagegap"><button class="big" id="checkBtn" disabled onclick="checkYourList()">Check my list</button></p>
  </div>

  <div class="card" id="stage1card" style="display:none;">
    <h2>Your Answers</h2>
    <div class="sub">Yes means it's on our semester list. No means it isn't, or the spelling is too different to match.</div>
    <div id="yourAnswers"></div>
    <div class="score" id="correctSoFar"></div>
  </div>

  <div class="card" id="stage2card" style="display:none;">
    <h2>Hint</h2>
    <div class="hintbox" id="hintText"></div>
    <div class="stagegap" style="display:flex;gap:.6rem;align-items:center;">
      <input type="text" id="hintGuess" placeholder="Type the title here" style="flex:1;padding:.6rem;border:1px solid var(--line);border-radius:6px;font-family:Arial,sans-serif;font-size:.9rem;">
      <button class="big" onclick="submitHintGuess()">Submit</button>
    </div>
    <div id="hintFeedback" style="font-family:Arial,sans-serif;font-weight:700;margin-top:.6rem;"></div>
    <p class="stagegap"><button class="ghost" onclick="showHint()">Skip, give me a different hint</button></p>
  </div>

  <div class="card" id="stage3card" style="display:none;">
    <h2>Ready to See Everything?</h2>
    <div class="sub" id="revealSub">You have 10 correct. This stays unlocked from now on.</div>
    <button class="big" onclick="revealAnswer()">Reveal full answer</button>
  </div>

  <div class="card" id="resultsCard" style="display:none;">
    <div class="score" id="scoreLine"></div>
    <div class="resultgrid">
      <div class="hitlist"><h3>Found</h3><div id="hitItems"></div></div>
      <div class="misslist"><h3>Missed</h3><div id="missItems"></div></div>
    </div>
  </div>

  <div class="card">
    <h2>Bonus: Can't Remember a Title?</h2>
    <div class="sub">Describe it here instead. We will try to work out what it was.</div>
    <textarea id="bonusBox" style="min-height:100px;" placeholder="It was a black and white photo of..."></textarea>
    <p style="margin-top:.8rem;"><button class="big" onclick="submitBonus()">Submit description</button></p>
    <div id="bonusMsg" style="font-family:Arial,sans-serif;font-weight:700;color:#2F8F5B;margin-top:.5rem;"></div>
  </div>
</main>

<script>
var master = [
  {t:"Apsara Dance", h:"A traditional Cambodian court dance with intricate hand gestures."},
  {t:"Dia de los Muertos altars", h:"A joyful Mexican tradition celebrating deceased loved ones."},
  {t:"Islamic Geometric Art", h:"Infinite repeating pattern used instead of the human figure."},
  {t:"Starry Night", h:"A swirling night sky over a quiet village, by Van Gogh."},
  {t:"These Thoughts May Disappear", h:"A controversial exhibition debut that got a one star review."},
  {t:"Jerusalema Flash Dances", h:"A viral 2020 dance challenge set to a South African song."},
  {t:"Piss Christ", h:"A crucifix submerged in the artist's own bodily fluid."},
  {t:"Metamorphosis of Narcissus", h:"A surrealist retelling of the Narcissus myth, egg-like forms."},
  {t:"The Dark Side of the Moon", h:"A prism refracting light on a famous album cover."},
  {t:"Spirited Away", h:"A girl trapped working in a spirit world bathhouse."},
  {t:"One Piece", h:"A pirate manga about a boy searching for treasure."},
  {t:"Minecraft", h:"A blocky sandbox game built entirely from cubes."},
  {t:"Jackson Pollock drip paintings", h:"Paint dripped and flung rather than brushed onto canvas."},
  {t:"Yayoi Kusama dot motifs", h:"An artist obsessed with repeating a single polka dot."},
  {t:"Pacita Abad layered paintings", h:"Thick, textured layers of oil paint built up like relief."},
  {t:"Birth of Venus", h:"A goddess emerging from the sea on a shell."},
  {t:"Olympia", h:"A reclining nude who stares back at the viewer."},
  {t:"The Kiss", h:"Two figures embracing, covered in gold leaf patterning."},
  {t:"The Broken Column", h:"A self portrait with the spine replaced by a shattered pillar."},
  {t:"Untitled Film Still", h:"An artist photographing herself as if in a movie scene."},
  {t:"Lemonade", h:"A visual album about betrayal and Black Southern identity."},
  {t:"Cookie Thumper", h:"A deliberately grotesque, excessive South African music video."},
  {t:"Somnyama Ngonyama", h:"A self portrait series reclaiming Black queer identity."},
  {t:"Be a Lady They Said", h:"A spoken word piece listing contradictory rules given to women."},
  {t:"Goya's Madhouse", h:"An asylum interior questioning who gets called insane."},
  {t:"Battle Royale", h:"Students forced to fight to the death on an island."},
  {t:"Nosedive, Black Mirror", h:"A world where a star rating controls your entire life."},
  {t:"Deutschland", h:"A German band's song wrestling with national guilt and pride."},
  {t:"Cambodian hol textiles", h:"Hand woven Cambodian silk using an ikat dyeing technique."},
  {t:"Foot Binding", h:"A painful beauty standard once enforced on Chinese women's feet."},
  {t:"Steel wool photography", h:"Spinning burning metal to throw sparks across a long exposure."},
  {t:"David Bowie, Ziggy Stardust", h:"A glam rock alter ego in a jumpsuit by Kansai Yamamoto."},
  {t:"Leang Seckon, Return Home", h:"A Cambodian collage artist reflecting on repatriation and homeland."},
  {t:"Tracey Emin, My Bed", h:"An unmade bed shown exactly as it was, mess included."},
  {t:"Banksy, Love is in the Air", h:"A masked figure throwing a bouquet like a grenade."},
  {t:"Banksy, Kissing Coppers", h:"Two police officers caught mid kiss in a stencil mural."},
  {t:"Sopheap Pich, woven sculpture", h:"Bamboo and rattan woven into large sculptural forms."},
  {t:"Banksy, Flag Statue, Waterloo Place", h:"A suited man blinded by his own flag, about to fall."},
  {t:"Nighthawks, Hopper", h:"Late night diner customers lit starkly against a dark street."},
  {t:"The Calling of St Matthew, Caravaggio", h:"A shaft of light picks out a tax collector in shadow."},
  {t:"The Pantheon oculus", h:"A single round opening lets light move across a domed ceiling."},
  {t:"Light Prop for an Electric Stage, Moholy-Nagy", h:"A kinetic sculpture built purely to move light and shadow."},
  {t:"Bon Om Touk water festival lights", h:"Illuminated boats on the river during Cambodia's water festival."},
  {t:"The Lovers, Magritte", h:"Two people kissing with their faces wrapped in cloth."},
  {t:"Weeping Woman, Picasso", h:"A fractured cubist face crying, in sharp coloured planes."},
  {t:"Un Chien Andalou", h:"A surrealist film infamous for a shocking eye scene."},
  {t:"Bayon Temple, Angkor Thom", h:"Giant stone faces looking out from a Cambodian temple gate."},
  {t:"Rhythm 0, Abramovic", h:"An artist let the audience use 72 objects on her body."},
  {t:"Hi Ren", h:"A song staging a conversation between an artist and his dark side."},
  {t:"60 inch Cuboctahedron, Anthony James", h:"A large geometric sculpture exploring infinity through form."},
  {t:"Reversible Rotation, teamLab", h:"An immersive light sculpture with no fixed physical form."},
  {t:"On the Asymmetry of the Universe, teamLab", h:"An installation questioning why nothing reflects perfectly."},
  {t:"Infinite Awakening, Mikael B", h:"A painting marking the start of a new creative chapter."},
  {t:"Insult to Injury, Chapman Brothers", h:"Original Goya prints deliberately defaced by two artists."},
  {t:"Mona Lisa", h:"A small portrait famous for its mysterious half smile."},
  {t:"Living Architecture, Refik Anadol", h:"A Gaudi building reanimated using AI and its own data."},
  {t:"Power Rangers", h:"Ordinary teenagers transform to fight monsters as a team."},
  {t:"The Scream, Munch", h:"A figure holds its face, mouth open, sky blood red."},
  {t:"Ballroom Culture", h:"An LGBTQ+ scene built around voguing and chosen family."},
  {t:"Combat Sports as High Art", h:"An article arguing fighting deserves to be studied like painting."},
  {t:"Crime and Punishment, Dostoevsky", h:"A novel following a murderer's spiral of guilt."},
  {t:"Identification, Abu-Se-Ken", h:"A Vocaloid producer's unsettling debut single."},
  {t:"Into the Wild, Erin Hunter", h:"The first book in a series about warring cat clans."},
  {t:"Christina's World, Wyeth", h:"A woman lies in a field, gazing up at a distant house."},
  {t:"Enola Holmes", h:"Sherlock's younger sister solves her own mystery."},
  {t:"Fountain, Duchamp", h:"A urinal signed and submitted as a sculpture."},
  {t:"Crystallization, Iris van Herpen", h:"The designer's first 3D printed dress on a runway."},
  {t:"This Is America, Childish Gambino", h:"A music video hiding violence in plain sight."},
  {t:"Parasite, Bong Joon-ho", h:"A film mapping class through the levels of a house."},
  {t:"The Thinker, Rodin", h:"A seated bronze figure lost in contemplation."},
  {t:"Note by Note Cuisine", h:"A meal built from pure chemistry, no plants or animals."},
  {t:"Biafra, Don McCullin", h:"A war photograph documenting famine during a Nigerian civil war."},
  {t:"Forgotten Promise, Uelsmann", h:"A darkroom composite photograph carrying a sense of guilt."},
  {t:"Pumped Up Kicks, Foster the People", h:"A cheerful sounding song hiding very dark lyrics."},
  {t:"In the Summertime, Mungo Jerry", h:"A carefree classic pop song about summer."},
  {t:"Black Museum, Black Mirror", h:"An episode about a collection of horrors sold as souvenirs."},
];

var t = 600, tid;
function startTimer(){
  document.getElementById('timerBtn').disabled = true;
  tid = setInterval(function(){
    t--; var m = Math.floor(t/60), s = t%60;
    document.getElementById('timerDisplay').textContent = m+":"+(s<10?"0":"")+s;
    if(t<=0){ clearInterval(tid); document.getElementById('timerDisplay').textContent = "Time!"; }
  }, 1000);
}

function normalise(s){ return s.toLowerCase().replace(/[^a-z0-9]/g, ""); }

function getUserLines(){
  return document.getElementById('userList').value.split("\n").map(function(s){ return s.trim(); }).filter(Boolean);
}

function updateCounter(){
  var n = getUserLines().length;
  var el = document.getElementById('counter');
  el.textContent = n + ' of 10 minimum';
  el.classList.toggle('done', n >= 10);
  document.getElementById('checkBtn').disabled = n < 10;
}

function matchMaster(line){
  var nl = normalise(line);
  if(nl.length < 3) return null;
  for(var i=0;i<master.length;i++){
    var nm = normalise(master[i].t);
    if(nm.indexOf(nl) !== -1 || nl.indexOf(nm) !== -1) return master[i];
  }
  return null;
}

var matched = {};

function checkYourList(){
  var lines = getUserLines();
  if(lines.length < 10){ return; }
  var html = '';
  lines.forEach(function(line){
    var m = matchMaster(line);
    if(m){
      html += '<div class="yesno yes">YES &mdash; "' + line + '" matches ' + m.t + '</div>';
      matched[m.t] = true;
    } else {
      html += '<div class="yesno no">NO &mdash; "' + line + '" is not on our list, or check the spelling</div>';
    }
  });
  document.getElementById('yourAnswers').innerHTML = html;
  document.getElementById('stage1card').style.display = 'block';
  document.getElementById('stage1card').scrollIntoView({behavior:'smooth'});
  updateCorrectCount();
  if(correctCount() < 10){
    showHint();
  }
}

function correctCount(){
  return Object.keys(matched).length;
}

function updateCorrectCount(){
  var n = correctCount();
  document.getElementById('correctSoFar').textContent = n + ' of 10 needed to unlock the full reveal';
  if(n >= 10){
    unlockReveal();
  }
}

function unlockReveal(){
  document.getElementById('stage2card').style.display = 'none';
  document.getElementById('stage3card').style.display = 'block';
  document.getElementById('revealSub').textContent = 'You have ' + correctCount() + ' correct. This stays unlocked from now on.';
  document.getElementById('stage3card').scrollIntoView({behavior:'smooth'});
}

var currentHint = null;
function showHint(){
  var missing = master.filter(function(m){ return !matched[m.t]; });
  if(missing.length === 0){
    document.getElementById('hintText').textContent = "You have found everything. Nice work.";
    document.getElementById('stage2card').style.display = 'block';
    return;
  }
  currentHint = missing[Math.floor(Math.random() * missing.length)];
  document.getElementById('hintText').textContent = currentHint.h;
  document.getElementById('hintGuess').value = '';
  document.getElementById('hintFeedback').textContent = '';
  document.getElementById('stage2card').style.display = 'block';
  document.getElementById('stage2card').scrollIntoView({behavior:'smooth'});
}

function submitHintGuess(){
  var val = document.getElementById('hintGuess').value.trim();
  if(!val || !currentHint) return;
  var nl = normalise(val);
  var nm = normalise(currentHint.t);
  var correct = nl.length > 2 && (nm.indexOf(nl) !== -1 || nl.indexOf(nm) !== -1);
  if(correct){
    matched[currentHint.t] = true;
    document.getElementById('hintFeedback').textContent = 'Correct! That was ' + currentHint.t + '.';
    document.getElementById('hintFeedback').style.color = '#2F8F5B';
    updateCorrectCount();
    if(correctCount() < 10){
      setTimeout(showHint, 900);
    }
  } else {
    document.getElementById('hintFeedback').textContent = 'Not quite, try again, or skip for a different hint.';
    document.getElementById('hintFeedback').style.color = '#C0392B';
  }
}

function revealAnswer(){
  var hits = master.filter(function(m){ return matched[m.t]; }).map(function(m){ return m.t; });
  var misses = master.filter(function(m){ return !matched[m.t]; }).map(function(m){ return m.t; });
  document.getElementById('hitItems').innerHTML = hits.map(function(h){ return '<div class="item">\u2713 '+h+'</div>'; }).join('') || '<div class="item">None yet</div>';
  document.getElementById('missItems').innerHTML = misses.map(function(m){ return '<div class="item">\u2717 '+m+'</div>'; }).join('') || '<div class="item">Nothing missed, well done</div>';
  document.getElementById('scoreLine').textContent = hits.length + ' of ' + master.length + ' found';
  document.getElementById('resultsCard').style.display = 'block';
  document.getElementById('resultsCard').scrollIntoView({behavior:'smooth'});
}

var STOPWORDS = {"a":1,"an":1,"the":1,"of":1,"in":1,"on":1,"at":1,"to":1,"and":1,"or":1,"with":1,"is":1,"was":1,"it":1,"that":1,"this":1,"there":1,"were":1,"are":1,"i":1,"a photo":1,"about":1,"by":1,"as":1,"for":1,"has":1,"had":1,"have":1,"be":1,"been":1,"one":1,"some":1,"think":1,"remember":1,"maybe":1,"something":1,"someone":1};

function keywordsOf(text){
  return text.toLowerCase().replace(/[^a-z0-9\s]/g, "").split(/\s+/).filter(function(w){
    return w.length > 2 && !STOPWORDS[w];
  });
}

function suggestFromDescription(desc){
  var words = keywordsOf(desc);
  if(words.length === 0) return [];
  var scored = master.map(function(m){
    var pool = keywordsOf(m.t + " " + m.h);
    var score = 0;
    words.forEach(function(w){
      pool.forEach(function(p){
        if(p === w || p.indexOf(w) !== -1 || w.indexOf(p) !== -1) score++;
      });
    });
    return { m: m, score: score };
  }).filter(function(x){ return x.score > 0; });
  scored.sort(function(a,b){ return b.score - a.score; });
  return scored.slice(0, 3).map(function(x){ return x.m; });
}

function submitBonus(){
  var box = document.getElementById('bonusBox');
  var val = box.value.trim();
  if(!val) return;
  var suggestions = suggestFromDescription(val);
  var msgEl = document.getElementById('bonusMsg');
  if(suggestions.length === 0){
    msgEl.innerHTML = 'Saved: "' + val + '". No close matches found, ask your teacher or the class.';
  } else {
    var list = suggestions.map(function(m){ return '<div class="item">Could it be <b>' + m.t + '</b>? ' + m.h + '</div>'; }).join('');
    msgEl.innerHTML = 'Based on what you wrote, maybe one of these:<br>' + list;
  }
}
</script>
</body>
</html>
